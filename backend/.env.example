# Variables shared with the previous Go service: copy them from its .env.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_MODE=disable

# Initial SMTP settings; after the first start they are edited in the admin (Почта → Настройки SMTP).
EMAIL=orgcom@spacescitech.com
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=465

# Django.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=.spacescitech.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://spacescitech.com,https://*.spacescitech.com
# DJANGO_ADMIN_PATH=api/admin/
# Encrypts the SMTP password in the database; defaults to a key derived from DJANGO_SECRET_KEY.
# FIELD_ENCRYPTION_KEY=
# Restrict CORS instead of allowing every origin:
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://spacescitech.com
# GUNICORN_WORKERS=3
# REGISTRATION_THROTTLE=30/hour
