# Copy to .env for local development. Production builds take these values from the deploy workflow
# (.github/workflows/deploy.yml) and the repository variables on GitHub.

# Backend API base URL. Locally: the Django dev server, e.g. http://127.0.0.1:8000/api
VITE_API_URL=/api

# Russian version: "true" to turn it on. In production this is the repository variable
# VITE_RU_ENABLED (Settings → Secrets and variables → Actions → Variables); re-run the deploy after changing it.
VITE_RU_ENABLED=false
